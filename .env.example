# Copie este arquivo para .env e preencha com os dados do seu projeto Supabase
# Acesse: https://supabase.com → seu projeto → Settings → API

VITE_SUPABASE_URL=https://SEU_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=sua_anon_key_aqui

# Token de upload do servidor de midia (media.aladim.digital).
# Publico por natureza: vai no bundle. O token de EXCLUSAO nao
# fica aqui — vive na Edge Function media-delete.
VITE_MEDIA_UPLOAD_TOKEN=
